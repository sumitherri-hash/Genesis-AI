# Copy to .env locally and fill these values. Never commit .env.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=replace_with_your_provider_key
GENESIS_ADMIN_KEY=replace_with_a_long_random_secret
GENESIS_DB=genesis.db
POLL_SECONDS=90
MAX_TASKS_PER_CYCLE=2
COUNCIL_POLL_SECONDS=15
COUNCIL_MAX_DAILY_CALLS=36
COUNCIL_MAX_ATTEMPTS=3
COUNCIL_MISSION_INTERVAL_SECONDS=21600

# Optional social sign-in provider credentials. Never commit real values.
# Google can reuse GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET; add the login callback URI too.
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
